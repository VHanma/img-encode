    private void importDna(Uri uri){setBusy("Consensus-style DNA ensemble recovery…");worker.execute(()->{try{DnaAdvancedCodec.DecodeResult dr;try(InputStream in=getContentResolver().openInputStream(uri)){byte[] dnaText=ByteUtil.readAll(in);String head=new String(dnaText,0,Math.min(dnaText.length,180),"US-ASCII");if(!head.contains(">SpectraDNA-MAX")){if(head.matches("(?s).*\\b[0-9a-fA-F]{64}\\b.*"))throw new IOException("That is a SHA-256 checksum file, not a DNA MAX archive");throw new IOException("This text file is not a SpectraDNA MAX DNA archive");}dr=DnaAdvancedCodec.decodeFasta(new ByteArrayInputStream(dnaText));}ArchiveContainer a=ArchiveContainer.parse(ArchiveContainer.inflate(dr.data));verifyBitmapAgainstArchive(a);recoveredArchive=a;currentArchive=a;compressedArchive=dr.data;Bitmap canon=BitmapFactory.decodeByteArray(a.canonicalPng,0,a.canonicalPng.length);Bitmap small=Bitmap.createScaledBitmap(canon,224,128,true);int[] px=new int[224*128];small.getPixels(px,0,224,0,0,224,128);spectrogramArt=SpectrogramArt.renderMax(px,224,128);pendingWavName=safeBase(a.fileName)+"-SpectraDNA-MAX.wav";lastWavUri=null;runOnUiThread(()->{preview.setImageBitmap(canon);enableRecoverySaves(a);wavBtn.setEnabled(true);phoneBtn.setEnabled(true);archiveBtn.setEnabled(true);labWavBtn.setEnabled(true);playBtn.setEnabled(false);shareBtn.setEnabled(false);status.setText("DNA → PIXEL-PERFECT VERIFIED ✓  AUTO REBUILD STARTING…");details.setText("DENSE valid: "+dr.validDense+"  •  SYNC valid: "+dr.validSync+"\nRejected/damaged records: "+dr.badRecords+"  •  parity-recovered shards: "+dr.recoveredShards+"\nCanonical SHA-256: "+ByteUtil.hex(a.canonicalSha)+"\nRaw RGBA SHA-256: "+ByteUtil.hex(a.pixelSha)+"\nTile Merkle root: "+ByteUtil.hex(a.merkleRoot)+"\n\nAudio, DNA and manifests rebuild automatically.");buildEverything();});}catch(Exception e){fail(e);}});}

    private void runLab(){if(compressedArchive==null)return;setBusy("Destruction Lab attacking sacrificial copies…");worker.execute(()->{try{RecoveryLab.Report r=RecoveryLab.run(compressedArchive);runOnUiThread(()->{status.setText("DESTRUCTION LAB  "+r.score()+"%"+(r.score()==100?" ✓":""));details.setText(r.toString()+"\nA failed row is kept visible rather than hidden. It identifies the next recovery layer to strengthen.");});}catch(Exception e){fail(e);}});}

    private void verifyBitmapAgainstArchive(ArchiveContainer a)throws Exception{Bitmap b=BitmapFactory.decodeByteArray(a.canonicalPng,0,a.canonicalPng.length);if(b==null)throw new IOException("Recovered PNG could not decode");byte[] rgba=rawRgba(b);if(!ByteUtil.equals(ByteUtil.sha256(rgba),a.pixelSha))throw new IOException("Decoded-pixel SHA-256 mismatch");if(a.rawRgba.length>0&&!ByteUtil.equals(rgba,a.rawRgba))throw new IOException("Canonical PNG pixels differ from stored raw RGBA");if(a.rawRgba.length>0&&!TileIntegrity.verify(rgba,a.width,a.height,a.tileSize,a.tileHashes,a.merkleRoot))throw new IOException("Tile/Merkle verification failed after image decode");}
    private byte[] rawRgba(Bitmap b)throws IOException{int w=b.getWidth(),h=b.getHeight();long n=(long)w*h*4;if(n>Integer.MAX_VALUE)throw new IOException("Image too large for raw pixel archive");byte[] out=new byte[(int)n];int[] row=new int[w];int q=0;for(int y=0;y<h;y++){b.getPixels(row,0,w,0,y,w,1);for(int c:row){out[q++]=(byte)(c>>>16);out[q++]=(byte)(c>>>8);out[q++]=(byte)c;out[q++]=(byte)(c>>>24);}}return out;}
    private void enableRecoverySaves(ArchiveContainer a){savePngBtn.setEnabled(true);saveOriginalBtn.setEnabled(a.originalBytes!=null&&a.originalBytes.length>0);}
    private void saveBytes(Uri uri,byte[] b,String msg){worker.execute(()->{try(OutputStream out=getContentResolver().openOutputStream(uri,"w")){out.write(b);runOnUiThread(()->status.setText(msg));}catch(Exception e){fail(e);}});}
    private String queryName(Uri uri){try(Cursor c=getContentResolver().query(uri,new String[]{OpenableColumns.DISPLAY_NAME},null,null,null)){if(c!=null&&c.moveToFirst())return c.getString(0);}catch(Exception ignored){}return"image";}
    private String safeBase(String s){if(s==null||s.isEmpty())return"image";int d=s.lastIndexOf('.');if(d>0)s=s.substring(0,d);return s.replaceAll("[^A-Za-z0-9._-]","_");}
    private String fmt(long n){if(n>=1048576)return String.format("%.2f MB",n/1048576.0);if(n>=1024)return String.format("%.1f KB",n/1024.0);return n+" B";}
    private String fmtCount(long n){if(n>=1_000_000_000L)return String.format("%.2fB",n/1e9);if(n>=1_000_000L)return String.format("%.2fM",n/1e6);if(n>=1000)return String.format("%.1fk",n/1000.0);return Long.toString(n);}
    private void setBusy(String s){runOnUiThread(()->status.setText(s));}
    private void fail(Exception e){runOnUiThread(()->{status.setText("ERROR: "+e.getMessage());details.setText(android.util.Log.getStackTraceString(e));});}
    @Override protected void onDestroy(){super.onDestroy();if(player!=null){try{player.stop();}catch(Exception ignored){}player.release();player=null;}worker.shutdownNow();auxWorker.shutdownNow();}
}
